<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:taste_vnv_toolkit.ViewModels"
        x:Class="taste_vnv_toolkit.Views.AppConfigWindow"
        x:DataType="vm:AppConfigViewModel"
        Title="Application Configuration"
        Width="560"
        Height="230"
        Background="#2D2D2D"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid RowDefinitions="*,Auto" Margin="16">

        <!-- Settings list (all string/directory entries) -->
        <ScrollViewer Grid.Row="0">
            <ItemsControl ItemsSource="{Binding Settings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolSettingViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       MinWidth="180"
                                       VerticalAlignment="Center"
                                       Foreground="#CCCCCC"
                                       FontSize="13"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding StringValue}"
                                     FontSize="13"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Cancel / Save -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="16,6"/>
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
