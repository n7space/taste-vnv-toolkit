<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:taste_vnv_toolkit.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Background="#202020"
        ExtendClientAreaToDecorationsHint="True"
        IsHitTestVisible="True"
        BorderBrush="DarkGray"
        BorderThickness="1"
        x:Class="taste_vnv_toolkit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Icon="/Assets/avalonia-logo.ico"
        Title="TASTE VnV Toolkit"
        Width="800"
        Height="600">

    <Grid RowDefinitions="Auto,*">

        <!-- Title bar -->
        <Border Grid.Row="0"
                Background="#1A1A1A"
                BorderBrush="#444"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="TASTE VnV Toolkit"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#E0E0E0"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="⚙"
                        ToolTip.Tip="Application configuration"
                        Command="{Binding OpenAppConfigCommand}"
                        Width="32" Height="32"
                        Padding="0"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Tool groups scrollable area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ToolGroups}" Margin="8"
                          HorizontalAlignment="Stretch">
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,4">
                            <Expander.Header>
                                <TextBlock Text="{Binding GroupName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0"/>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Tools}" Margin="8,4"
                                          HorizontalAlignment="Stretch">
                                <ItemsControl.Styles>
                                    <Style Selector="ItemsControl > ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2A2A2A"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,2"
                                                Padding="8,6">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">

                                                <!-- Tool name -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           ToolTip.Tip="{Binding Hint}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#DDDDDD"
                                                           FontSize="13"/>

                                                <!-- Status icon -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding StatusIcon}"
                                                           ToolTip.Tip="{Binding StatusText}"
                                                           Foreground="{Binding StatusColor}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontSize="14"
                                                           Margin="8,0"/>

                                                <!-- Help button -->
                                                <Button Grid.Column="2"
                                                        Content="?"
                                                        ToolTip.Tip="Show help"
                                                        Command="{Binding ShowHelpCommand}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Margin="2,0"/>

                                                <!-- Configure button -->
                                                <Button Grid.Column="3"
                                                        Content="⚙"
                                                        ToolTip.Tip="Configure"
                                                        Command="{Binding ConfigureCommand}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        FontSize="14"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Margin="2,0"/>

                                                <!-- View button -->
                                                <Button Grid.Column="4"
                                                        Content="⊙"
                                                        ToolTip.Tip="View results"
                                                        Command="{Binding ViewCommand}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        FontSize="14"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Margin="2,0"/>

                                                <!-- Run button -->
                                                <Button Grid.Column="5"
                                                        Content="▶"
                                                        ToolTip.Tip="Run tool"
                                                        Command="{Binding RunToolCommand}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        FontSize="13"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Margin="2,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</Window>
