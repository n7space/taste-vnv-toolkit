#ifdef __NEED_PID_Range_UPER
int Encode_UPER_PID_Range(void *pBuffer, size_t iMaxBufferSize, const asn1SccPID_Range *pSrc, int *errorCode)
{
    (void)iMaxBufferSize;
    int outErrorCode;
    STATIC BitStream strm;

    BitStream_Init(&strm, pBuffer, iMaxBufferSize);
    if (asn1SccPID_Range_Encode(pSrc, &strm, &outErrorCode, TRUE) == FALSE) {
       if (errorCode != NULL) {
           *errorCode = outErrorCode;
       }
#ifdef __unix__
	fprintf(stderr, "Could not encode PID-Range (at %s, %d), errorCode was %d\n", __FILE__, __LINE__, outErrorCode);
#endif
        return -1;
    } else {
        return BitStream_GetLength(&strm);
    }
}
#endif

