--  Node name          : samv71asw
--  Execution platform : PLATFORM_SAMV71_RTEMS
--  This file is generated for SAMV71 with RTEMS6




project Samv71asw is

   type Build_Type is ("Debug", "Release");
   Build : Build_Type := external ("CFG", "Debug");

   --  following to be updated with all relevant source dirs
   for Source_Dirs use
      (
       "../../controller/C/src",
       "../../controller/C/wrappers",
       "../../datapool/C/src",
