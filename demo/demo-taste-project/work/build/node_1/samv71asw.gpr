       "../../samv71asw_timer_manager/Timer_Manager/wrappers",
       "../../utilities/C/src",
       "../../utilities/C/wrappers",
       "../../dataview/C",
       "../system_spec",
       "samv71asw/runtime",
       "samv71asw/runtime/Broker",
       "samv71asw/runtime/Escaper",
       "samv71asw/runtime/Packetizer",
       "samv71asw/runtime/RuntimeCommon",
       "samv71asw/runtime/SAMX-RTEMS-Runtime/src",
       "samv71asw/runtime/SAMX-RTEMS-Runtime/src/Hal",
       "samv71asw/runtime/SAMX-RTEMS-Runtime/src/Monitor",
       "samv71asw/runtime/SAMX-RTEMS-Runtime/src/ThreadsCommon",
