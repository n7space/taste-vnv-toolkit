<?xml version="1.0" encoding="utf-8"?>
<ToolDefinition>
  <Name>Extract requirements from Excel to Doxygen tag file</Name>
  <Group>Documentation</Group>
  <Hint>Extract requirements from Excel spreadsheet to Doxygen tag file</Hint>
  <Description>Reads requirements from an Excel file and generates a Doxygen tag file for requirement tracing. The tool extracts requirement IDs and titles from specified columns and creates a properly formatted XML tag file.</Description>
  <StatusScript>status.py</StatusScript>
  <ToolScript>tool.py</ToolScript>
  <ViewScript>view.py</ViewScript>
  <ImportPaths>
    <Path>../shared</Path>
    <Path>../doxygen-shared</Path>
  </ImportPaths>
  <Settings>
    <Setting>
      <Name>Excel file name</Name>
      <Type>String</Type>
      <Default>demo_requirements.xlsx</Default>
    </Setting>
    <Setting>
      <Name>Sheet name</Name>
      <Type>String</Type>
      <Default>5. Requirements</Default>
    </Setting>
    <Setting>
      <Name>ID column</Name>
      <Type>String</Type>
      <Default>A</Default>
    </Setting>
    <Setting>
      <Name>Title column</Name>
      <Type>String</Type>
      <Default>C</Default>
    </Setting>
    <Setting>
      <Name>Header row</Name>
      <Type>Int</Type>
      <Default>2</Default>
    </Setting>
    <Setting>
      <Name>Data start row</Name>
      <Type>Int</Type>
      <Default>3</Default>
    </Setting>
    <Setting>
      <Name>Output tag file</Name>
      <Type>String</Type>
      <Default>doxygen-requirements.tag</Default>
    </Setting>
  </Settings>
</ToolDefinition>
